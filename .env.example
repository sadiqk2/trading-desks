# Kite Connect API credentials (server only; never place these in frontend env files)
KITE_API_KEY=
KITE_API_SECRET=
# Optional daily token for unattended backend starts; OAuth callback also stores it in memory only.
KITE_ACCESS_TOKEN=
# Register this exact callback URL in your Kite Connect application settings.
KITE_REDIRECT_URL=http://localhost:8000/api/auth/callback

# Local backend URLs. Docker Compose overrides hostnames for its private network.
DATABASE_URL=postgresql+psycopg://kite:kite_dev_password@localhost:5432/option_intelligence
REDIS_URL=redis://localhost:6379/0
# Where the backend sends the browser after Kite login (also allowed for CORS).
# Local dev with Vite: http://localhost:5173 | Docker Compose: http://localhost:8080
FRONTEND_URL=http://localhost:5173

# Postgres container bootstrap for docker compose (change these outside local development).
POSTGRES_DB=option_intelligence
POSTGRES_USER=kite
POSTGRES_PASSWORD=kite_dev_password

# Dashboard / analytics configuration
APP_PORT=8080
API_PORT=8000
RISK_FREE_RATE=0.06
OI_WALL_PERCENTILE=90
STALE_AFTER_SECONDS=15
LOG_LEVEL=INFO
